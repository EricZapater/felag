# =============================================================================
# FELAG - Backend Environment Variables (.env.backend)
# =============================================================================

# PostgreSQL Configuration (connects to existing PostgreSQL in postgres-network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=felag
DB_SSLMODE=disable

# API Configuration
PORT=8080
GIN_MODE=release
AUTO_MIGRATE=true

# JWT Security (Generate a secure 32+ character random string)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION_HOURS=24

# Timezone
TZ=Europe/Madrid

# Frontend Base URL
APP_BASE_URL=https://felag.app

# Public API / Server Base URL
BASE_URL=https://api.felag.app

# Local Upload Directory
UPLOAD_DIR=/app/uploads

# Cloudflare R2 / S3-compatible Object Storage Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=felag-profiles
R2_PUBLIC_URL=
