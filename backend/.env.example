# =============================================================================
# FELAG - Backend Environment Variables (.env.backend)
# =============================================================================

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=felag
DB_SSLMODE=disable

# API Configuration
PORT=8080
GIN_MODE=debug
AUTO_MIGRATE=true

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION_HOURS=24

# Timezone
TZ=Europe/Madrid

# Frontend Base URL
APP_BASE_URL=http://localhost:3000

# Public API / Server Base URL
BASE_URL=http://localhost:8080

# Local Upload Directory
UPLOAD_DIR=./uploads

# Cloudflare R2 / S3-compatible Object Storage Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=felag-profiles
R2_PUBLIC_URL=
